{
  "name": "@tdu/ui",
  "version": "0.1.0",
  "description": "A date picker with a positional mask, a smart popover, a time row and presets. Vanilla DOM, React and Stimulus (Rails, Hotwire). No dependency.",
  "keywords": [
    "datepicker",
    "date-picker",
    "datetime",
    "mask",
    "popover",
    "calendar",
    "range",
    "react",
    "hook",
    "stimulus",
    "hotwire",
    "rails",
    "turbo"
  ],
  "homepage": "https://github.com/thadeu/ndb/tree/main/console/lib/ui#readme",
  "bugs": {
    "url": "https://github.com/thadeu/ndb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thadeu/ndb.git",
    "directory": "console/lib/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./stimulus": {
      "import": {
        "types": "./dist/stimulus.d.ts",
        "default": "./dist/stimulus.js"
      },
      "require": {
        "types": "./dist/stimulus.d.cts",
        "default": "./dist/stimulus.cjs"
      }
    },
    "./date-picker.css": "./dist/date-picker.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp styles/date-picker.css dist/date-picker.css",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@hotwired/stimulus": ">=3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@hotwired/stimulus": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
