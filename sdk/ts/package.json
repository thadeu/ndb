{
  "name": "@thadeu/ndb",
  "version": "1.23.3",
  "description": "TypeScript client for the ndb daemon",
  "keywords": [
    "ndb",
    "ndjson",
    "database",
    "client"
  ],
  "homepage": "https://ndb.clowk.in/clients/typescript",
  "bugs": {
    "url": "https://github.com/thadeu/ndb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thadeu/ndb.git",
    "directory": "sdk/ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ioredis": {
      "import": {
        "types": "./dist/ioredis.d.ts",
        "default": "./dist/ioredis.js"
      },
      "require": {
        "types": "./dist/ioredis.d.cts",
        "default": "./dist/ioredis.cjs"
      }
    },
    "./node-redis": {
      "import": {
        "types": "./dist/node-redis.d.ts",
        "default": "./dist/node-redis.js"
      },
      "require": {
        "types": "./dist/node-redis.d.cts",
        "default": "./dist/node-redis.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "ioredis": "^5.11.1",
    "redis": "^5.12.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
