{
  "name": "find with an empty where returns every document",
  "collection": "posts",
  "setup": {
    "catalog": { "write": "engine" },
    "writes": [
      { "op": "bulk", "body": { "docs": [{ "_id": "p1", "status": "draft" }] } },
      { "op": "bulk", "body": { "docs": [{ "_id": "p2", "status": "published" }] } }
    ]
  },
  "request": { "op": "search", "body": { "query": {} } },
  "expect": {
    "ordered": false,
    "rows": [
      { "_id": "p1", "status": "draft" },
      { "_id": "p2", "status": "published" }
    ]
  }
}
