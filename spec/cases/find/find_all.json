{
  "name": "find with an empty where returns every document",
  "collection": "posts",
  "setup": {
    "catalog": { "id": "post_id", "write": "engine" },
    "writes": [
      { "op": "insert", "body": { "insert": [{ "post_id": "p1", "status": "draft" }] } },
      { "op": "insert", "body": { "insert": [{ "post_id": "p2", "status": "published" }] } }
    ]
  },
  "request": { "op": "find", "body": { "where": {} } },
  "expect": {
    "ordered": false,
    "rows": [
      { "post_id": "p1", "status": "draft" },
      { "post_id": "p2", "status": "published" }
    ]
  }
}
