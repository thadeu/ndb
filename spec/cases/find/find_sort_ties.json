{
  "name": "sort with ties on the first key ends in id order",
  "collection": "posts",
  "setup": {
    "catalog": {
      "id": "post_id",
      "write": "engine"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "post_id": "c",
              "g": 1
            },
            {
              "post_id": "a",
              "g": 1
            },
            {
              "post_id": "b",
              "g": 0
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "sort": {
        "g": 1
      }
    }
  },
  "expect": {
    "ordered": true,
    "rows": [
      {
        "post_id": "b",
        "g": 0
      },
      {
        "post_id": "a",
        "g": 1
      },
      {
        "post_id": "c",
        "g": 1
      }
    ]
  }
}
