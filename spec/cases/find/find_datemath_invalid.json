{
  "name": "a broken date math expression is invalid_query",
  "collection": "events",
  "setup": {
    "catalog": {
      "write": "engine",
      "time": "at"
    },
    "writes": [
      {
        "op": "bulk",
        "body": {
          "docs": [
            {
              "_id": "e1",
              "at": "2020-01-01T00:00:00Z",
              "note": "now-1h"
            },
            {
              "_id": "e2",
              "at": "2099-01-01T00:00:00Z",
              "note": "x"
            },
            {
              "_id": "e3",
              "at": "2020-06-01T12:00:00+02:00",
              "note": "y"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "search",
    "body": {
      "query": {
        "at": {
          "$gte": "now-7x"
        }
      }
    }
  },
  "expect": {
    "error": "invalid_query"
  }
}
