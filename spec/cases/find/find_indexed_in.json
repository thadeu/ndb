{
  "name": "find with $in on an indexed field",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine",
      "indexes": [
        "ref"
      ]
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "c0",
              "ref": "p0"
            },
            {
              "_id": "c1",
              "ref": "p1"
            },
            {
              "_id": "c2",
              "ref": "p2"
            },
            {
              "_id": "c3",
              "ref": "p0"
            },
            {
              "_id": "c4",
              "ref": "p1"
            },
            {
              "_id": "c5",
              "ref": "p2"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "where": {
        "ref": {
          "$in": [
            "p1",
            "p2"
          ]
        }
      }
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "_id": "c1",
        "ref": "p1"
      },
      {
        "_id": "c2",
        "ref": "p2"
      },
      {
        "_id": "c4",
        "ref": "p1"
      },
      {
        "_id": "c5",
        "ref": "p2"
      }
    ]
  }
}
