{
  "name": "find with $or, $and and $not",
  "collection": "posts",
  "setup": {
    "catalog": {
      "id": "post_id",
      "write": "engine"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "post_id": "p1",
              "status": "draft",
              "n": 1,
              "tags": [
                "a",
                "b"
              ],
              "meta": {
                "city": "Rio"
              }
            },
            {
              "post_id": "p2",
              "status": "published",
              "n": 2,
              "tags": [
                "b"
              ],
              "meta": {
                "city": "SP"
              }
            },
            {
              "post_id": "p3",
              "status": "published",
              "n": 3,
              "meta": {}
            },
            {
              "post_id": "p4",
              "status": null,
              "n": 4,
              "tags": []
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "where": {
        "$or": [
          {
            "n": 1
          },
          {
            "$and": [
              {
                "status": "published"
              },
              {
                "n": {
                  "$not": {
                    "$lt": 3
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "post_id": "p1",
        "status": "draft",
        "n": 1,
        "tags": [
          "a",
          "b"
        ],
        "meta": {
          "city": "Rio"
        }
      },
      {
        "post_id": "p3",
        "status": "published",
        "n": 3,
        "meta": {}
      }
    ]
  }
}
