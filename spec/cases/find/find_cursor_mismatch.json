{
  "name": "a cursor made for another query returns cursor_mismatch",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "p1",
              "status": "draft",
              "n": 1,
              "tags": [
                "a",
                "b"
              ],
              "meta": {
                "city": "Rio"
              }
            },
            {
              "_id": "p2",
              "status": "published",
              "n": 2,
              "tags": [
                "b"
              ],
              "meta": {
                "city": "SP"
              }
            },
            {
              "_id": "p3",
              "status": "published",
              "n": 3,
              "meta": {}
            },
            {
              "_id": "p4",
              "status": null,
              "n": 4,
              "tags": []
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "sort": {
        "n": 1
      },
      "after": "eyJzIjpbWzEsMV1dLCJpIjoicDEiLCJwIjowLCJoIjoiMDAwMDAwMDAwMDAwMDAwMCJ9"
    }
  },
  "expect": {
    "error": "cursor_mismatch"
  }
}
