{
  "name": "rows older than the retention window by the time field are not returned",
  "collection": "sessions",
  "setup": {
    "catalog": {
      "write": "engine",
      "time": "at",
      "retention": "30d"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "old",
              "at": "2020-01-01T00:00:00Z"
            },
            {
              "_id": "new",
              "at": "2999-01-01T00:00:00Z"
            },
            {
              "_id": "no_time"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "where": {}
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "_id": "new",
        "at": "2999-01-01T00:00:00Z"
      },
      {
        "_id": "no_time"
      }
    ]
  }
}
