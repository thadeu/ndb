{
  "name": "$regex lookahead is not RE2 and returns invalid_query",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "p1",
              "title": "Alpha release",
              "tags": [
                "alpha",
                "beta"
              ],
              "meta": {
                "city": "Rio"
              },
              "n": 1
            },
            {
              "_id": "p2",
              "title": "alpine climb",
              "tags": [
                "gamma"
              ],
              "meta": {
                "city": "SP"
              },
              "n": 2
            },
            {
              "_id": "p3",
              "title": "Beta notes",
              "tags": [],
              "meta": {
                "city": "rio grande"
              },
              "n": 3
            },
            {
              "_id": "p4",
              "title": null,
              "meta": {},
              "n": 4
            },
            {
              "_id": "p5",
              "title": 42,
              "tags": [
                7,
                "alp9"
              ],
              "n": 5
            },
            {
              "_id": "p6",
              "n": 6
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "where": {
        "title": {
          "$regex": "a(?=b)"
        }
      }
    }
  },
  "expect": {
    "error": "invalid_query"
  }
}
