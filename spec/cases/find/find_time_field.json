{
  "name": "find compares the time field as time, not as text",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine",
      "time": "at"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "a",
              "at": "2026-11-04T10:00:00-03:00"
            },
            {
              "_id": "b",
              "at": "2026-11-04T12:30:00Z"
            },
            {
              "_id": "c",
              "at": "2026-11-04T11:00:00Z"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "where": {
        "at": {
          "$lt": "2026-11-04T12:00:00Z"
        }
      }
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "_id": "c",
        "at": "2026-11-04T11:00:00Z"
      }
    ]
  }
}
