{
  "name": "$regex ignores numbers, null and missing values",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine"
    },
    "writes": [
      {
        "op": "bulk",
        "body": {
          "docs": [
            {
              "_id": "p1",
              "title": "Alpha release",
              "tags": [
                "alpha",
                "beta"
              ],
              "meta": {
                "city": "Rio"
              },
              "n": 1
            },
            {
              "_id": "p2",
              "title": "alpine climb",
              "tags": [
                "gamma"
              ],
              "meta": {
                "city": "SP"
              },
              "n": 2
            },
            {
              "_id": "p3",
              "title": "Beta notes",
              "tags": [],
              "meta": {
                "city": "rio grande"
              },
              "n": 3
            },
            {
              "_id": "p4",
              "title": null,
              "meta": {},
              "n": 4
            },
            {
              "_id": "p5",
              "title": 42,
              "tags": [
                7,
                "alp9"
              ],
              "n": 5
            },
            {
              "_id": "p6",
              "n": 6
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "search",
    "body": {
      "query": {
        "title": {
          "$regex": ".*"
        }
      }
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "_id": "p1",
        "title": "Alpha release",
        "tags": [
          "alpha",
          "beta"
        ],
        "meta": {
          "city": "Rio"
        },
        "n": 1
      },
      {
        "_id": "p2",
        "title": "alpine climb",
        "tags": [
          "gamma"
        ],
        "meta": {
          "city": "SP"
        },
        "n": 2
      },
      {
        "_id": "p3",
        "title": "Beta notes",
        "tags": [],
        "meta": {
          "city": "rio grande"
        },
        "n": 3
      }
    ]
  }
}
