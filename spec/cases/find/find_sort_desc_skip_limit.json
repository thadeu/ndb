{
  "name": "sort descending with skip and limit",
  "collection": "posts",
  "setup": {
    "catalog": {
      "id": "post_id",
      "write": "engine"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "post_id": "p0",
              "n": 0
            },
            {
              "post_id": "p1",
              "n": 1
            },
            {
              "post_id": "p2",
              "n": 2
            },
            {
              "post_id": "p3",
              "n": 3
            },
            {
              "post_id": "p4",
              "n": 4
            },
            {
              "post_id": "p5",
              "n": 5
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "find",
    "body": {
      "sort": {
        "n": -1
      },
      "skip": 1,
      "limit": 2
    }
  },
  "expect": {
    "ordered": true,
    "rows": [
      {
        "post_id": "p4",
        "n": 4
      },
      {
        "post_id": "p3",
        "n": 3
      }
    ]
  }
}
