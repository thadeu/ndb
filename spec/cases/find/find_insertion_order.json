{
  "name": "no sort returns insertion order",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine"
    },
    "writes": [
      {
        "op": "bulk",
        "body": {
          "docs": [
            {
              "_id": "z"
            },
            {
              "_id": "a"
            },
            {
              "_id": "m"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "search",
    "body": {}
  },
  "expect": {
    "ordered": true,
    "rows": [
      {
        "_id": "z"
      },
      {
        "_id": "a"
      },
      {
        "_id": "m"
      }
    ]
  }
}
