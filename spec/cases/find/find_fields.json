{
  "name": "fields keep only the listed paths",
  "collection": "posts",
  "setup": {
    "catalog": {
      "write": "engine"
    },
    "writes": [
      {
        "op": "bulk",
        "body": {
          "docs": [
            {
              "_id": "p1",
              "status": "draft",
              "n": 1,
              "tags": [
                "a",
                "b"
              ],
              "meta": {
                "city": "Rio"
              }
            },
            {
              "_id": "p2",
              "status": "published",
              "n": 2,
              "tags": [
                "b"
              ],
              "meta": {
                "city": "SP"
              }
            },
            {
              "_id": "p3",
              "status": "published",
              "n": 3,
              "meta": {}
            },
            {
              "_id": "p4",
              "status": null,
              "n": 4,
              "tags": []
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "search",
    "body": {
      "query": {
        "_id": "p1"
      },
      "fields": [
        "status",
        "meta.city"
      ]
    }
  },
  "expect": {
    "ordered": false,
    "rows": [
      {
        "status": "draft",
        "meta": {
          "city": "Rio"
        }
      }
    ]
  }
}
