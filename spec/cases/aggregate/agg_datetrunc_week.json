{
  "name": "dateTrunc week starts on Monday",
  "collection": "calls",
  "setup": {
    "catalog": {
      "id": "call_id",
      "time": "ts",
      "write": "engine",
      "indexes": [
        "status"
      ]
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "call_id": "c1",
              "status": "answered",
              "dur": 10,
              "queue": "sales",
              "ts": "2026-11-01T10:15:00Z",
              "tags": [
                "a"
              ]
            },
            {
              "call_id": "c2",
              "status": "answered",
              "dur": 20,
              "queue": "sales",
              "ts": "2026-11-01T10:45:00Z"
            },
            {
              "call_id": "c3",
              "status": "missed",
              "dur": null,
              "queue": "sales",
              "ts": "2026-11-01T11:05:00Z"
            },
            {
              "call_id": "c4",
              "status": "answered",
              "dur": 30,
              "queue": "support",
              "ts": "2026-11-02T09:00:00Z"
            },
            {
              "call_id": "c5",
              "status": "missed",
              "queue": "support",
              "ts": "2026-11-02T09:30:00Z"
            },
            {
              "call_id": "c6",
              "status": "abandoned",
              "dur": "n/a",
              "queue": "support",
              "ts": "2026-11-03T23:30:00Z"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "aggregate",
    "body": {
      "pipeline": [
        {
          "$group": {
            "_id": {
              "$dateTrunc": {
                "date": "$ts",
                "unit": "week"
              }
            },
            "n": {
              "$count": {}
            }
          }
        }
      ]
    }
  },
  "expect": {
    "ordered": true,
    "rows": [
      {
        "_id": "2026-10-26T00:00:00Z",
        "n": 3
      },
      {
        "_id": "2026-11-02T00:00:00Z",
        "n": 3
      }
    ]
  }
}
