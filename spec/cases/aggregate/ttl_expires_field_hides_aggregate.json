{
  "name": "aggregate does not group expired documents",
  "collection": "sessions",
  "setup": {
    "catalog": {
      "write": "engine",
      "expires_field": "exp"
    },
    "writes": [
      {
        "op": "insert",
        "body": {
          "insert": [
            {
              "_id": "past",
              "exp": "2020-01-01T00:00:00Z"
            },
            {
              "_id": "past_unix",
              "exp": 1577836800
            },
            {
              "_id": "future",
              "exp": "2999-01-01T00:00:00Z"
            },
            {
              "_id": "future_unix",
              "exp": 32503680000
            },
            {
              "_id": "never"
            },
            {
              "_id": "null_exp",
              "exp": null
            }
          ]
        }
      }
    ]
  },
  "request": {
    "op": "aggregate",
    "body": {
      "pipeline": [
        {
          "$group": {
            "_id": null,
            "n": {
              "$count": {}
            }
          }
        }
      ]
    }
  },
  "expect": {
    "ordered": true,
    "rows": [
      {
        "_id": null,
        "n": 4
      }
    ]
  }
}
