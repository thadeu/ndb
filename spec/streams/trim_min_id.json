{
  "name": "trim by min_id deletes the entries before it",
  "stream": "orders",
  "steps": [
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 1
        },
        "id": "1-0"
      },
      "expect": {
        "body": {
          "_id": "1-0"
        }
      }
    },
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 2
        },
        "id": "2-0"
      },
      "expect": {
        "body": {
          "_id": "2-0"
        }
      }
    },
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 3
        },
        "id": "3-0"
      },
      "expect": {
        "body": {
          "_id": "3-0"
        }
      }
    },
    {
      "op": "trim",
      "body": {
        "min_id": "2-0"
      },
      "expect": {
        "body": {
          "deleted": 1
        }
      }
    },
    {
      "op": "search",
      "body": {
        "sort": {
          "_id": 1
        }
      },
      "expect": {
        "rows": [
          {
            "_id": "2-0",
            "n": 2
          },
          {
            "_id": "3-0",
            "n": 3
          }
        ],
        "ignore": [
          "_ts",
          "idle_ms",
          "inactive_ms"
        ]
      }
    },
    {
      "op": "info",
      "expect": {
        "body": {
          "length": 2,
          "first_id": "2-0",
          "last_id": "3-0",
          "entries_added": 3,
          "max_deleted_id": "0-0",
          "groups": 0
        }
      }
    }
  ]
}
