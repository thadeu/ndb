{
  "name": "a trim deletes entries but keeps their PEL references; claim reports them in deleted",
  "stream": "orders",
  "steps": [
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 1
        },
        "id": "1-0"
      },
      "expect": {
        "body": {
          "_id": "1-0"
        }
      }
    },
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 2
        },
        "id": "1-1"
      },
      "expect": {
        "body": {
          "_id": "1-1"
        }
      }
    },
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 3
        },
        "id": "1-2"
      },
      "expect": {
        "body": {
          "_id": "1-2"
        }
      }
    },
    {
      "op": "group_create",
      "group": "g",
      "body": {
        "start": "0"
      }
    },
    {
      "op": "read",
      "group": "g",
      "body": {
        "consumer": "c1",
        "count": 1
      }
    },
    {
      "op": "trim",
      "body": {
        "max_len": 2
      },
      "expect": {
        "body": {
          "deleted": 1
        }
      }
    },
    {
      "op": "count",
      "expect": {
        "body": {
          "count": 2
        }
      }
    },
    {
      "op": "read",
      "group": "g",
      "body": {
        "consumer": "c1",
        "pending": true
      },
      "expect": {
        "rows": [
          {
            "_id": "1-0",
            "_deleted": true
          }
        ]
      }
    },
    {
      "op": "claim",
      "group": "g",
      "body": {
        "consumer": "c2",
        "min_idle_ms": 0,
        "ids": [
          "1-0"
        ]
      },
      "expect": {
        "body": {
          "entries": [],
          "deleted": [
            "1-0"
          ]
        }
      }
    },
    {
      "op": "pending",
      "group": "g",
      "body": {},
      "expect": {
        "body": {
          "count": 0,
          "lowest": null,
          "highest": null,
          "consumers": []
        }
      }
    }
  ]
}
