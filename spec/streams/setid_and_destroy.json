{
  "name": "setid moves the group back; destroy removes it",
  "stream": "orders",
  "steps": [
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 1
        },
        "id": "1-0"
      },
      "expect": {
        "body": {
          "_id": "1-0"
        }
      }
    },
    {
      "op": "append",
      "body": {
        "doc": {
          "n": 2
        },
        "id": "1-1"
      },
      "expect": {
        "body": {
          "_id": "1-1"
        }
      }
    },
    {
      "op": "group_create",
      "group": "g",
      "body": {
        "start": "$"
      }
    },
    {
      "op": "setid",
      "group": "g",
      "body": {
        "id": "1-0"
      },
      "expect": {
        "body": {
          "group": "g",
          "last_delivered_id": "1-0"
        }
      }
    },
    {
      "op": "read",
      "group": "g",
      "body": {
        "consumer": "c1"
      },
      "expect": {
        "rows": [
          {
            "_id": "1-1",
            "n": 2
          }
        ],
        "ignore": [
          "_ts",
          "idle_ms",
          "inactive_ms"
        ]
      }
    },
    {
      "op": "group_destroy",
      "group": "g",
      "expect": {
        "body": {
          "deleted": true
        }
      }
    },
    {
      "op": "read",
      "group": "g",
      "body": {
        "consumer": "c1"
      },
      "expect": {
        "error": "unknown_group"
      }
    }
  ]
}
